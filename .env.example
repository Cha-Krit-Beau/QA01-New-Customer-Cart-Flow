# =============================================================================
# Environment variable template.
# Copy this file to .env.<environment> (e.g. .env.dev, .env.sit, .env.uat)
# and fill in real values. NEVER commit the copied file — only this template
# is tracked in git (see .gitignore: .env / .env.*).
#
# Which file gets loaded is controlled by TEST_ENV, e.g.:
#   TEST_ENV=dev  -> .env.dev
#   TEST_ENV=sit  -> .env.sit
#   TEST_ENV=uat  -> .env.uat
#   TEST_ENV=prod -> .env.prod
# =============================================================================

# Target environment name (dev | sit | uat | prod). Determines which .env file
# playwright.config.ts loads at startup.
TEST_ENV=dev

# Base URL of the application under test (UI).
BASE_URL=https://the-internet.herokuapp.com

# Base URL of the API under test.
API_BASE_URL=https://jsonplaceholder.typicode.com

# Base URL of the TestDino Demo Store scenario (tests/storedemo, "storedemo" project).
# Separate from BASE_URL because it targets a different application entirely.
STOREDEMO_BASE_URL=https://storedemo.testdino.com

# Credentials for the standard test user. Never use real production
# credentials here — use a dedicated, low-privilege test account.
TEST_USERNAME=tomsmith
TEST_PASSWORD=SuperSecretPassword!

# Optional: API key/token if the API under test requires one.
API_KEY=

# Playwright execution behaviour
HEADLESS=true
